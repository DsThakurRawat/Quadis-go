# Port to listen on (default 3001)
PORT=3001

# Environment: "development" or "production"
NODE_ENV=development

# Database connection URL (PostgreSQL). If empty, falls back to in-memory store
DATABASE_URL=postgres://quadis:password@127.0.0.1:5432/quadis

# Security & Sessions
ADMIN_PIN=998877
ADMIN_PASSWORD=local-dev-token
SESSION_SECRET=local-dev-session-secret

# Razorpay configuration
RAZORPAY_KEY_ID=rzp_test_simulated
RAZORPAY_KEY_SECRET=secret_simulated
RAZORPAY_WEBHOOK_SECRET=secret_simulated_webhook

# AI Assistant keys (Gemini / Groq)
GROQ_API_KEY=
GEMINI_API_KEY=

# ResAvenue OTA Channel Manager
RESAVENUE_USERNAME=
RESAVENUE_PASSWORD=
RESAVENUE_HOTEL_CODE=
RESAVENUE_OTA_URL=

# WhatsApp / Notifications
OWNER_WHATSAPP_PHONE=919217373532
CORS_ORIGIN=http://localhost:5173
